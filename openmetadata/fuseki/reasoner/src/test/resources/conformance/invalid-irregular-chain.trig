# Two property chains that each define the other's property: the role hierarchy is not regular.
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX :     <http://example.org/invalid-irregular-chain#>

GRAPH <urn:fixture:invalid-irregular-chain> {
  <http://example.org/invalid-irregular-chain> a owl:Ontology .
  :p a owl:ObjectProperty ; owl:propertyChainAxiom ( :q :s ) .
  :q a owl:ObjectProperty ; owl:propertyChainAxiom ( :p :s ) .
  :s a owl:ObjectProperty .
}
