# A transitive property cannot also be functional in OWL 2 DL.
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX :     <http://example.org/invalid-transitive-functional#>

GRAPH <urn:fixture:invalid-transitive-functional> {
  <http://example.org/invalid-transitive-functional> a owl:Ontology .
  :partOf a owl:ObjectProperty , owl:TransitiveProperty , owl:FunctionalProperty .
}
