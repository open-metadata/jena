# A value outside the declared range of a datatype property.
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX :     <http://example.org/dl-data-range-inconsistent#>

GRAPH <urn:fixture:dl-data-range-inconsistent> {
  <http://example.org/dl-data-range-inconsistent> a owl:Ontology .
  :rowCount a owl:DatatypeProperty ; rdfs:range xsd:integer .
  :table1 a owl:NamedIndividual ; :rowCount "many"^^xsd:string .
}
