# An individual of two disjoint classes makes the ontology inconsistent: nothing else is reported.
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX :     <http://example.org/el-disjoint-inconsistent#>

GRAPH <urn:fixture:el-disjoint-inconsistent> {
  <http://example.org/el-disjoint-inconsistent> a owl:Ontology .
  :Table a owl:Class ; owl:disjointWith :Dashboard .
  :Dashboard a owl:Class .
  :Report a owl:Class ; rdfs:subClassOf :Dashboard .
  :sales a owl:NamedIndividual , :Table , :Report .
}
