# A restriction without owl:onProperty cannot be mapped to OWL; its triples are never dropped
# silently.
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX :     <http://example.org/invalid-malformed-restriction#>

GRAPH <urn:fixture:invalid-malformed-restriction> {
  <http://example.org/invalid-malformed-restriction> a owl:Ontology .
  :Customer a owl:Class ; rdfs:subClassOf [ a owl:Restriction ; owl:someValuesFrom :Account ] .
  :Account a owl:Class .
}
