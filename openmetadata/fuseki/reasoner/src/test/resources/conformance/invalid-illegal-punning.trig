# One IRI used as both an object property and a datatype property is illegal punning; it is
# reported, not repaired.
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX :     <http://example.org/invalid-illegal-punning#>

GRAPH <urn:fixture:invalid-illegal-punning> {
  <http://example.org/invalid-illegal-punning> a owl:Ontology .
  :code a owl:ObjectProperty , owl:DatatypeProperty .
}
