# Pairwise disjointness makes a class unsatisfiable while the ontology stays consistent.
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX :     <http://example.org/el-disjoint-unsatisfiable#>

GRAPH <urn:fixture:el-disjoint-unsatisfiable> {
  <http://example.org/el-disjoint-unsatisfiable> a owl:Ontology .
  :Asset a owl:Class .
  :Person a owl:Class ; owl:disjointWith :Asset .
  :Contractor a owl:Class ; rdfs:subClassOf :Person , :Asset .
  :TemporaryContractor a owl:Class ; rdfs:subClassOf :Contractor .
  :Employee a owl:Class ; rdfs:subClassOf :Person .
}
