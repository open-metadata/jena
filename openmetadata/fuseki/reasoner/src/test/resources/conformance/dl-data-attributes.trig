# Term attributes and identifier attributes: datatype properties with domains and ranges in the
# OWL 2 datatype map, a functional identifier, and data property assertions with typed values.
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX :     <http://example.org/dl-data-attributes#>

GRAPH <urn:fixture:dl-data-attributes> {
  <http://example.org/dl-data-attributes> a owl:Ontology .
  :identifier a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain :Identified ; rdfs:range xsd:string .
  :createdAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
  :rowCount a owl:DatatypeProperty ; rdfs:range xsd:integer .
  :score a owl:DatatypeProperty ; rdfs:range xsd:decimal .
  :active a owl:DatatypeProperty ; rdfs:range xsd:boolean .
  :homepage a owl:DatatypeProperty ; rdfs:range xsd:anyURI .
  :label a owl:DatatypeProperty ; rdfs:range rdf:PlainLiteral .
  :Identified a owl:Class .
  :Scored a owl:Class ; owl:equivalentClass [ a owl:Restriction ; owl:onProperty :score ; owl:someValuesFrom xsd:decimal ] .
  :Counted a owl:Class ; owl:equivalentClass [ a owl:Restriction ; owl:onProperty :rowCount ; owl:someValuesFrom xsd:integer ] .
  :table1 a owl:NamedIndividual ;
    :identifier "tbl-0001" ;
    :createdAt "2026-10-08T12:00:00Z"^^xsd:dateTime ;
    :rowCount "42"^^xsd:integer ;
    :score "0.75"^^xsd:decimal ;
    :active true ;
    :homepage "https://example.org/table1"^^xsd:anyURI ;
    :label "Orders"@en .
  :table2 a owl:NamedIndividual ; :identifier "tbl-0002" ; :identifier "tbl-0002"^^xsd:string .
}
