# The reasoner launcher from the command line, with the settings, memory-budget check, lock and
# worker launch command the Fuseki extension uses. Inside the container:
#   reasoner readiness          the memory budget as JSON; exits 0 only when READY
#   reasoner run STEP_FILE...   run worker steps in order, one JSON outcome each
#   reasoner command STEP_FILE  print the worker's launch command
# This JVM is small and separate from both Fuseki and the worker; its own memory is not counted
# as Fuseki's.

set -euo pipefail

: "${FUSEKI_HOME:=/jena-fuseki}"

exec env -u JAVA_TOOL_OPTIONS -u JDK_JAVA_OPTIONS -u _JAVA_OPTIONS \
  java -Xmx64m -Xss512k -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -XX:MaxMetaspaceSize=64m \
  -Dlog4j2.configurationFile="$FUSEKI_HOME/log4j2.properties" \
  -cp "$FUSEKI_HOME/extensions/openmetadata-fuseki-extensions.jar:$FUSEKI_HOME/fuseki-server.jar" \
  org.openmetadata.fuseki.reasoning.ReasonerCli "$@"
