# Values of the reasoner settings and whether they are valid. The entrypoint's
# validate_reasoning_settings and the extension's ReasoningSettings must both agree with every
# line; extension/src/test/.../ReasoningSettingsParityTest runs them through both.
# variable<TAB>value<TAB>valid|invalid; an empty value is the variable set to the empty string.
OPENMETADATA_REASONING_ENABLED	true	valid
OPENMETADATA_REASONING_ENABLED	false	valid
OPENMETADATA_REASONING_ENABLED		valid
OPENMETADATA_REASONING_ENABLED	yes	invalid
OPENMETADATA_REASONING_ENABLED	TRUE	invalid
OPENMETADATA_REASONER_HEAP		valid
OPENMETADATA_REASONER_HEAP	16m	valid
OPENMETADATA_REASONER_HEAP	2g	valid
OPENMETADATA_REASONER_HEAP	2G	valid
OPENMETADATA_REASONER_HEAP	1t	valid
OPENMETADATA_REASONER_HEAP	16384k	valid
OPENMETADATA_REASONER_HEAP	16383k	invalid
OPENMETADATA_REASONER_HEAP	15m	invalid
OPENMETADATA_REASONER_HEAP	0	invalid
OPENMETADATA_REASONER_HEAP	lots	invalid
OPENMETADATA_REASONER_HEAP	-1g	invalid
OPENMETADATA_REASONER_HEAP	 2g	invalid
OPENMETADATA_REASONER_HEAP	2gb	invalid
OPENMETADATA_REASONER_HEAP	9999999999999	valid
OPENMETADATA_REASONER_HEAP	99999999999999	invalid
OPENMETADATA_REASONER_HEAP	8388607t	valid
OPENMETADATA_REASONER_HEAP	8388608t	invalid
OPENMETADATA_REASONER_HEAP	9999999999999t	invalid
OPENMETADATA_REASONER_OFF_HEAP		valid
OPENMETADATA_REASONER_OFF_HEAP	512m	valid
OPENMETADATA_REASONER_OFF_HEAP	1g	valid
OPENMETADATA_REASONER_OFF_HEAP	511m	invalid
OPENMETADATA_REASONER_OFF_HEAP	256m	invalid
OPENMETADATA_REASONER_PAGE_CACHE_FLOOR		valid
OPENMETADATA_REASONER_PAGE_CACHE_FLOOR	0	valid
OPENMETADATA_REASONER_PAGE_CACHE_FLOOR	1	valid
OPENMETADATA_REASONER_PAGE_CACHE_FLOOR	0%	valid
OPENMETADATA_REASONER_PAGE_CACHE_FLOOR	50%	valid
OPENMETADATA_REASONER_PAGE_CACHE_FLOOR	100%	valid
