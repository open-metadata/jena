# Values of the reasoner settings and whether they are valid. The entrypoint's
# validate_reasoning_settings and the extension's ReasoningSettings and JobSettings must all agree
# with every line; extension/src/test/.../ReasoningSettingsParityTest runs them through both.
# variable<TAB>value<TAB>valid|invalid; an empty value is the variable set to the empty string.
OPENMETADATA_REASONING_ENABLED	true	valid
OPENMETADATA_REASONING_ENABLED	false	valid
