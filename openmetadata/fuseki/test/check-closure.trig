#
# Ontology graphs as OpenMetadata writes them, one per term and axiom, and the version manifest of
# the Approved closure of https://open-metadata.org/ontology/finance, whose closure digest is
# closure-digest sha256:f84eca3a8f684983ed64508cb957ac95a2ccea8a471d70e29f405919b24a2bfb
# The Draft graph draft/loan is not pinned; with it the closure would be inconsistent. The smoke
# test checks this closure through the image; CaptureTest checks that the manifest still matches.
PREFIX : <https://open-metadata.org/finance#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX omr: <https://open-metadata.org/reasoning/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

<https://open-metadata.org/graph/glossaryTerm/asset> {
    :Asset  a       owl:Class .
}

<https://open-metadata.org/graph/glossaryTerm/liability> {
    :Liability  a   owl:Class .
}

<https://open-metadata.org/graph/asset/loan> {
    :loan   a       owl:NamedIndividual;
            a       :Asset .
}

<https://open-metadata.org/graph/draft/loan> {
    :loan   a       :Liability .
}

<https://open-metadata.org/graph/axiom/disjoint> {
    _:b0    a            owl:AllDisjointClasses;
            owl:members  _:b1 .
    _:b1    <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest>  _:b2;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#first>  :Asset .
    _:b2    <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest>  <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil>;
            <http://www.w3.org/1999/02/22-rdf-syntax-ns#first>  :Liability .
}

<https://open-metadata.org/graph/glossaryTerm/hybrid> {
    :Hybrid  rdfs:subClassOf  :Liability;
            rdfs:subClassOf  :Asset;
            a                owl:Class .
}

<https://open-metadata.org/graph/manifest/f84eca3a8f684983ed64508cb957ac95a2ccea8a471d70e29f405919b24a2bfb> {
    <https://open-metadata.org/ontology/finance/version/f84eca3a8f684983ed64508cb957ac95a2ccea8a471d70e29f405919b24a2bfb>
            omr:glossary         <https://open-metadata.org/glossary/finance>;
            a                    omr:OntologyVersion;
            omr:memberCount      5;
            omr:digestAlgorithm  "om-closure-v2";
            omr:createdAt        "2026-10-15T08:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime>;
            omr:closureDigest    "sha256:f84eca3a8f684983ed64508cb957ac95a2ccea8a471d70e29f405919b24a2bfb";
            omr:selection        "APPROVED";
            omr:ontology         <https://open-metadata.org/ontology/finance> .
    <https://open-metadata.org/graph/glossaryTerm/asset>
            omr:pinnedDigest  "sha256:f5dcdb9bc4e19a78ebab203b154224504ed2bb9ef866d24d1d71767865c3fc13" .
    <https://open-metadata.org/graph/glossaryTerm/liability>
            omr:pinnedDigest  "sha256:0c9ab1e4d94e65e795074543cca370343700b2d8ab57a2cdb6db1b6abeebc90a" .
    <https://open-metadata.org/graph/asset/loan>
